# Production secrets — on EC2, populate from SSM Parameter Store (see docs/DEPLOY_AWS.md)
OPENAI_API_KEY=
XAI_API_KEY=
LANGSMITH_API_KEY=
POSTGRES_PASSWORD=
BASE_DOMAIN=b4rruf3t.com
TICKERS=SPY,QQQ
# Alpaca = real-time IEX quotes for chart/agents/GEX (SSM: /desk/ALPACA_KEY_ID + _SECRET)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
WATCH_SYMBOLS=SPY,QQQ,IWM
# Curated X list members (comma-separated handles) for the X pulse
X_LIST_HANDLES=
# glance, the unlisted private tool. Its hostname is deliberately not in this
# repo; set it here on the box. The two credentials are both required or the
# stack will not come up: the first is what a person types to read the page,
# the second is what the client sends to push data in. Never the same value.
PRIVATE_HOST=
GLANCE_PASSWORD=
GLANCE_INGEST_TOKEN=
