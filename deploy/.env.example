# Production secrets — on EC2, populate from SSM Parameter Store (see docs/DEPLOY_AWS.md)
OPENAI_API_KEY=
XAI_API_KEY=
LANGSMITH_API_KEY=
POSTGRES_PASSWORD=
BASE_DOMAIN=b4rruf3t.com
TICKERS=SPY,QQQ
# Alpaca = real-time IEX quotes for chart/agents/GEX (SSM: /desk/ALPACA_KEY_ID + _SECRET)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
WATCH_SYMBOLS=SPY,QQQ,IWM
# Curated X list members (comma-separated handles) for the X pulse
X_LIST_HANDLES=
# glance (remote.b4rruf3t.com). Both are required or the stack will not come
# up: the first is what a person types to read the page, the second is what the
# capture client sends to push a frame in. Never the same value.
GLANCE_PASSWORD=
GLANCE_INGEST_TOKEN=
